---
interface Props {
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;

interface MenuCard {
  id: string;
  name: string;
  subtitle: string;
  description: string;
  scheduleHint: string;
  ctaLabel: string;
  pdfUrl: string;
  coverWebp: string;
  coverFallback: string;
  coverAlt: string;
  coverBg: string;
  featured?: boolean;
}

const menus: MenuCard[] = [
  {
    id: 'desayunos',
    name: 'Desayunos',
    subtitle: 'Mañanas en La Casona · Desde las 8:00 a.m.',
    description:
      'Chilaquiles artesanales, enmoladas caseras, pan recién horneado, fruta de estación y nuestro tradicional café de puchero en el patio histórico.',
    scheduleHint: 'Todos los días desde las 8:00 a.m.',
    ctaLabel: 'Ver menú',
    pdfUrl: 'https://drive.google.com/file/d/1OBW64wj0ddP7eTgC72ebbxVOfsiaJZ9M/view?usp=sharing',
    coverWebp: '/optimized/portada-desayunos.webp',
    coverFallback: '/optimized/portada-desayunos.png',
    coverAlt:
      'Portada oficial del menú de Desayunos de Restaurante Apapacho en tono terracota con ornamentos clásicos y emblema Apapacho Aguascalientes México',
    coverBg: '#D17F66',
    featured: false,
  },
  {
    id: 'hidrocalido',
    name: 'Hidrocálido',
    subtitle: 'Legado Hidrocálido · Menú Insignia de Autor',
    description:
      'Un homenaje a las raíces gastronómicas de Aguascalientes: recetas de herencia familiar inspiradas en los sabores e ingredientes endémicos de nuestros municipios.',
    scheduleHint: 'Especialidades de temporada y tradición',
    ctaLabel: 'Consultar menú',
    pdfUrl: 'https://drive.google.com/file/d/1N3rnrUgAq4VCIAboiFM9XOuQEwyyEYVK/view?usp=sharing',
    coverWebp: '/optimized/portada-hidrocalido.webp',
    coverFallback: '/optimized/portada-hidrocalido.png',
    coverAlt:
      'Portada oficial del menú Legado Hidrocálido de Restaurante Apapacho con detalles dorados, sello superior y lema Sabor que acaricia el Alma',
    coverBg: '#FBF0E4',
    featured: true,
  },
  {
    id: 'comidas',
    name: 'Comidas',
    subtitle: 'Tardes y Veladas · Cocina de Autor',
    description:
      'Entradas para compartir en talavera, moles tradicionales, cortes selectos y platillos de autor pensados para disfrutar sin prisas en nuestra casona.',
    scheduleHint: 'Comidas y cenas todos los días',
    ctaLabel: 'Ver menú',
    pdfUrl: 'https://drive.google.com/file/d/1-ZJ0UtI0bUCPf8ur1-x9fWeJm_O3k7Dy/view?usp=sharing',
    coverWebp: '/optimized/portada-comidas.webp',
    coverFallback: '/optimized/portada-comidas.png',
    coverAlt:
      'Portada oficial del menú de Comidas de Restaurante Apapacho en tono verde mayólico con ornamentos blancos y emblema Cocina de Autor',
    coverBg: '#546E70',
    featured: false,
  },
];

const reviews = [
  {
    author: 'Reseña destacada en Google Maps',
    rating: 5,
    comment:
      '“Un lugar mágico en el Barrio del Encino. Te sientes como de visita en casa de los abuelos; el sazón del mole y la experiencia de conocer sus túneles subterráneos lo hacen único en Aguascalientes.”',
    context: 'Cena y recorrido histórico',
  },
  {
    author: 'Comensal local en Google Maps',
    rating: 5,
    comment:
      '“Los desayunos son un verdadero apapacho al corazón. Los chilaquiles, las enmoladas y el café de puchero tienen un sabor auténtico, casero y cuidado en cada detalle.”',
    context: 'Desayuno en terraza interior',
  },
  {
    author: 'Visitante en Redes Sociales',
    rating: 5,
    comment:
      '“Excelente atención y atmósfera cálida con música en vivo. Ideal para una velada romántica en la cueva subterránea o una comida familiar sin prisas.”',
    context: 'Velada de fin de semana',
  },
];
---

<!-- Sección: Nuestra Esencia / Nosotros -->
<section
  id="nuestra-esencia"
  aria-labelledby="nuestra-esencia-heading"
  class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto"
>
  <div id="nosotros" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <!-- Columna de Texto (Nuestra Esencia / Nosotros) -->
    <div class="lg:col-span-7 space-y-6">
      <h2
        id="nuestra-esencia-heading"
        class="font-serif text-3xl sm:text-4xl md:text-5xl text-apapacho-profundo leading-[1.15]"
      >
        Nuestra Esencia: un <span class="text-apapacho-mayolico font-semibold">apapacho</span> a la memoria y los sentidos
      </h2>

      <p class="font-sc text-sm tracking-wide text-apapacho-mayolico font-semibold">
        Nosotros · Tradición Hidrocálida en La Casona del Siglo XVIII
      </p>

      <p class="text-lg sm:text-xl text-apapacho-profundo/90 leading-relaxed max-w-xl text-justify">
        Ubicado en una <strong>casona histórica de finales del siglo XVIII</strong> en el emblemático
        <strong>Barrio del Encino</strong>, <em>APAPACHO</em> nace para rescatar la cocina tradicional hidrocálida con un toque
        contemporáneo de autor. Nuestro espacio evoca la calidez nostálgica de visitar la casa de los abuelos, donde cada receta se
        prepara con ingredientes locales como la guayaba de Calvillo, chiles secos y maíz criollo.
      </p>

      <p class="text-lg sm:text-xl text-apapacho-profundo/90 leading-relaxed max-w-xl text-justify">
        Quienes nos visitan destacan el sazón casero, la hospitalidad cercana de nuestro equipo y el carácter único de
        nuestra finca restaurada, cuyos muros centenarios, patios tradicionales y veladas con música en vivo honran la
        historia y la identidad cultural de Aguascalientes.
      </p>

      <!-- Franja editorial de hitos de identidad -->
      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 mt-6 border-t border-apapacho-oro/50">
        <div class="sm:pr-4 sm:border-r sm:border-apapacho-oro/40">
          <dt class="font-serif text-2xl sm:text-3xl font-semibold text-apapacho-profundo mb-1">
            Siglo XVIII
          </dt>
          <dd class="text-sm text-apapacho-profundo/80 leading-snug">
            Finca histórica restaurada en el corazón del Barrio del Encino.
          </dd>
        </div>
        <div class="sm:px-2 sm:border-r sm:border-apapacho-oro/40">
          <dt class="font-serif text-2xl sm:text-3xl font-semibold text-apapacho-profundo mb-1 tabular-nums">
            100% Local
          </dt>
          <dd class="text-sm text-apapacho-profundo/80 leading-snug">
            Cocina de autor inspirada en los sabores de Aguascalientes.
          </dd>
        </div>
        <div class="sm:pl-2">
          <dt class="font-serif text-2xl sm:text-3xl font-semibold text-apapacho-profundo mb-1 flex items-center gap-1.5 tabular-nums">
            <span>4.8</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="w-6 h-6 text-apapacho-adobe"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z"
                clip-rule="evenodd"
              />
            </svg>
          </dt>
          <dd class="text-sm text-apapacho-profundo/80 leading-snug">
            Calidez, música en vivo y atención como en casa.
          </dd>
        </div>
      </dl>
    </div>

    <!-- Columna Visual: Identidad e Historia de La Casona -->
    <div class="lg:col-span-5">
      <div class="bg-apapacho-blanco border border-apapacho-oro/50 rounded-3xl overflow-hidden shadow-warm-lg">
        <figure class="relative h-72 sm:h-80 overflow-hidden bg-apapacho-profundo">
          <img
            src="/optimized/fachada.webp"
            alt="Patio interior iluminado y arcos históricos de La Casona del siglo XVIII de Restaurante Apapacho en el Barrio del Encino"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            width="900"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-apapacho-profundo/90 via-apapacho-profundo/25 to-transparent"></div>
          <figcaption class="absolute bottom-4 left-5 right-5 flex items-center justify-between text-apapacho-blanco">
            <div>
              <p class="font-serif text-xl text-apapacho-blanco">
                La Casona del Siglo XVIII
              </p>
              <p class="font-sc text-xs uppercase tracking-[0.1em] text-apapacho-oro mt-0.5">
                Patrimonio e Identidad · Barrio del Encino
              </p>
            </div>
            <picture class="shrink-0">
              <source srcset="/optimized/logo-apapacho.webp" type="image/webp" />
              <img
                src="/LogoApapacho.jpg"
                alt="Sello Apapacho"
                class="w-12 h-12 rounded-full border border-apapacho-oro shadow-md"
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figcaption>
        </figure>
        <div class="p-6 sm:p-8 space-y-3">
          <h3 class="font-serif text-2xl sm:text-3xl text-apapacho-profundo leading-snug">
            Un rincón con historia y hospitalidad hidrocálida
          </h3>
          <p class="text-base text-apapacho-profundo/85 leading-relaxed text-justify">
            Cada rincón de nuestra casa conserva la arquitectura tradicional del Barrio del Encino, ofreciendo un espacio
            acogedor donde la tradición culinaria y la convivencia familiar son protagonistas.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sección: Nuestros Menús -->
<section
  id="especialidades"
  aria-labelledby="nuestros-menus-heading"
  class="py-20 sm:py-28 bg-apapacho-blanco border-y border-apapacho-oro/35"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-16">
      <h2
        id="nuestros-menus-heading"
        class="font-serif text-3xl sm:text-4xl md:text-5xl text-apapacho-profundo leading-tight"
      >
        Nuestros <span class="text-apapacho-mayolico font-semibold">Menús</span>
      </h2>
      <p class="font-sc text-sm tracking-wide text-apapacho-mayolico font-semibold mt-3">
        El Legado Culinario · Desayunos, Hidrocálido y Comidas de Autor
      </p>
      <p class="text-apapacho-profundo/85 mt-3 text-base sm:text-lg leading-relaxed">
        Explora nuestras cartas completas y descubre las recetas que honran la tradición gastronómica de Aguascalientes en cada momento del día.
      </p>
    </div>

    <!-- Tres Tarjetas de Menús: Desayunos (izq) · Hidrocálido (centro, principal) · Comidas (der) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-5 lg:gap-8 items-stretch pt-2 pb-4">
      {
        menus.map((menu) => (
          <article
            class:list={[
              'group relative max-w-md md:max-w-none mx-auto w-full rounded-3xl overflow-hidden transition-all duration-500 ease-out flex flex-col justify-between',
              menu.featured
                ? 'bg-apapacho-profundo text-apapacho-arena border-2 border-apapacho-oro shadow-warm-lg md:-translate-y-3 hover:-translate-y-1.5 md:hover:-translate-y-4 z-10'
                : 'bg-apapacho-arena text-apapacho-profundo border border-apapacho-oro/50 shadow-warm hover:shadow-warm-lg hover:-translate-y-1.5',
            ]}
          >
            <div>
              <!-- Portada Original del Menú (sin recortes ni deformación) -->
              <a
                href={menu.pdfUrl}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
                class="block overflow-hidden focus:outline-none"
              >
                <figure
                  class="relative aspect-[17/22] w-full overflow-hidden border-b border-apapacho-oro/35"
                  style={`background-color: ${menu.coverBg};`}
                >
                  <picture>
                    <source srcset={menu.coverWebp} type="image/webp" />
                    <img
                      src={menu.coverFallback}
                      alt={menu.coverAlt}
                      class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                      width="1200"
                      height="1553"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </figure>
              </a>

              <!-- Información Editorial de la Carta -->
              <div class="p-6 sm:p-7 md:p-5 lg:p-7">
                <h3
                  class:list={[
                    'font-serif text-2xl lg:text-3xl leading-snug',
                    menu.featured ? 'text-apapacho-blanco font-semibold' : 'text-apapacho-profundo',
                  ]}
                >
                  {menu.name}
                </h3>

                <p
                  class:list={[
                    'font-sc text-xs lg:text-sm tracking-wide font-semibold mt-1.5',
                    menu.featured ? 'text-apapacho-oro' : 'text-apapacho-mayolico',
                  ]}
                >
                  {menu.subtitle}
                </p>

                <p
                  class:list={[
                    'text-sm lg:text-base leading-relaxed mt-3.5 text-justify',
                    menu.featured ? 'text-apapacho-arena/90' : 'text-apapacho-profundo/85',
                  ]}
                >
                  {menu.description}
                </p>
              </div>
            </div>

            <!-- Pie de Tarjeta y Botón para Abrir el PDF en Nueva Pestaña -->
            <div
              class:list={[
                'px-6 sm:px-7 md:px-5 lg:px-7 pb-6 sm:pb-7 md:pb-5 lg:pb-7 pt-4 border-t flex flex-col gap-3.5',
                menu.featured ? 'border-apapacho-oro/30' : 'border-apapacho-oro/35',
              ]}
            >
              <a
                href={menu.pdfUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${menu.ctaLabel} de ${menu.name} (se abre en una nueva pestaña)`}
                class:list={[
                  'btn min-h-[48px] h-auto py-3 px-5 lg:px-6 w-full rounded-full font-serif text-base lg:text-lg tracking-wide transition-all duration-300 flex items-center justify-between',
                  menu.featured
                    ? 'bg-apapacho-oro hover:bg-apapacho-ladrillo text-apapacho-profundo border border-apapacho-oro hover:border-apapacho-ladrillo font-semibold shadow-warm'
                    : 'bg-apapacho-mayolico hover:bg-apapacho-profundo text-apapacho-blanco border border-apapacho-mayolico hover:border-apapacho-profundo font-normal shadow-warm',
                ]}
              >
                <span>{menu.ctaLabel}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Cintillo Editorial de Reservación -->
    <div class="mt-12 pt-8 border-t border-apapacho-oro/35 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p class="text-base sm:text-lg text-apapacho-profundo/85 font-serif">
        Servimos desayunos todos los días desde las <strong>8:00 a.m.</strong>, comidas de autor y veladas en La Casona.
      </p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-serif text-base sm:text-lg font-semibold text-apapacho-mayolico hover:text-apapacho-profundo min-h-[44px] shrink-0 transition-colors"
      >
        <span>Reservar mesa en WhatsApp</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- Sección: Reseñas de Comensales -->
<section id="resenas" class="py-20 sm:py-28 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-2xl mx-auto mb-14">
    <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-apapacho-profundo">
      Lo que dicen quienes nos visitan
    </h2>
    <p class="font-sc text-sm tracking-wide text-apapacho-mayolico font-semibold mt-3">
      Voces de Nuestra Mesa · Experiencias Reales
    </p>
    <p class="text-apapacho-profundo/85 mt-3 text-base sm:text-lg">
      Reseñas compartidas por nuestros comensales en Google Maps y redes sociales.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
    {
      reviews.map((review) => (
        <blockquote class="bg-apapacho-blanco border border-apapacho-oro/45 rounded-3xl p-7 sm:p-8 shadow-warm flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1 text-apapacho-adobe mb-5" aria-label={`${review.rating} de 5 estrellas`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" /></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" /></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" /></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" /></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" /></svg>
            </div>
            <p class="font-serif text-apapacho-profundo text-lg sm:text-xl italic leading-relaxed mb-6 text-justify">
              {review.comment}
            </p>
          </div>
          <footer class="border-t border-apapacho-oro/35 pt-4">
            <cite class="not-italic font-serif font-semibold text-base text-apapacho-profundo block">
              {review.author}
            </cite>
            <span class="text-sm text-apapacho-mayolico font-medium">{review.context}</span>
          </footer>
        </blockquote>
      ))
    }
  </div>
</section>
