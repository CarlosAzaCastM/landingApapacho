---
import { getActiveExperiences, type ExperienceItem } from '../data/experiences';

interface Props {
  experiences?: ExperienceItem[];
}

const { experiences } = Astro.props;
const activeExperiences = getActiveExperiences(experiences);
---

{
  activeExperiences.length > 0 && (
    <section
      id="experiencias"
      aria-labelledby="experiencias-heading"
      class="py-20 sm:py-28 bg-apapacho-blanco border-b border-apapacho-oro/35 overflow-hidden"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" data-experiences-carousel>
        <!-- Encabezado de Sección + Controles de Navegación del Carrusel -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 sm:mb-12">
          <div class="max-w-2xl">
            <h2
              id="experiencias-heading"
              class="font-serif text-3xl sm:text-4xl md:text-5xl text-apapacho-profundo leading-[1.15]"
            >
              Experiencias que <span class="text-apapacho-mayolico font-semibold">Apapachan</span>
            </h2>
            <p class="font-sc text-sm tracking-wide text-apapacho-mayolico font-semibold mt-2.5">
              Recorridos Subterráneos, Leyendas del Siglo XVIII y Eventos en el Barrio del Encino
            </p>
            <p class="text-base sm:text-lg text-apapacho-profundo/85 mt-3 leading-relaxed">
              Descubre las vivencias que resguarda nuestra finca histórica en Aguascalientes: desde veladas íntimas en
              nuestros túneles hasta recorridos de leyenda y celebraciones diseñadas a la medida.
            </p>
          </div>

          <!-- Controles de Navegación (Anterior / Siguiente + Indicador numérico) -->
          <div
            class="flex items-center justify-between sm:justify-start gap-3 self-stretch sm:self-auto pt-2 lg:pt-0"
            role="group"
            aria-label="Controles de navegación del carrusel de experiencias"
          >
            <span
              class="font-serif text-sm sm:text-base text-apapacho-profundo/80 tabular-nums mr-1"
              data-carousel-status
              aria-live="polite"
            >
              <strong class="text-apapacho-profundo font-semibold" data-carousel-current>1</strong>
              <span> / {activeExperiences.length}</span>
            </span>

            <div class="flex items-center gap-2.5">
              <button
                type="button"
                data-carousel-prev
                aria-label="Ver experiencia anterior"
                aria-controls="experiencias-track"
                class="btn btn-circle min-h-[46px] min-w-[46px] w-11 h-11 bg-apapacho-arena hover:bg-apapacho-mayolico text-apapacho-profundo hover:text-apapacho-blanco border border-apapacho-oro/60 hover:border-apapacho-mayolico shadow-sm transition-colors duration-200"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
              </button>

              <button
                type="button"
                data-carousel-next
                aria-label="Ver siguiente experiencia"
                aria-controls="experiencias-track"
                class="btn btn-circle min-h-[46px] min-w-[46px] w-11 h-11 bg-apapacho-arena hover:bg-apapacho-mayolico text-apapacho-profundo hover:text-apapacho-blanco border border-apapacho-oro/60 hover:border-apapacho-mayolico shadow-sm transition-colors duration-200"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Selector rápido de experiencias (accesible y sincronizado con el carrusel) -->
        <div
          class="flex items-center gap-2.5 overflow-x-auto pb-3 mb-7 scrollbar-none"
          role="tablist"
          aria-label="Seleccionar experiencia de La Casona"
        >
          {activeExperiences.map((exp, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`experiencia-card-${exp.slug}`}
              data-carousel-indicator={index}
              class:list={[
                'min-h-[44px] px-5 py-2 rounded-full font-serif text-base transition-all duration-200 shrink-0 border flex items-center gap-2',
                index === 0
                  ? 'bg-apapacho-profundo text-apapacho-arena border-apapacho-profundo shadow-sm font-semibold'
                  : 'bg-apapacho-arena/70 text-apapacho-profundo hover:bg-apapacho-oro/25 border-apapacho-oro/50 font-normal',
              ]}
            >
              <span
                class:list={[
                  'w-2 h-2 rounded-full transition-colors duration-200',
                  index === 0 ? 'bg-apapacho-oro' : 'bg-apapacho-adobe/60',
                ]}
                data-carousel-dot
                aria-hidden="true"
              />
              <span>{exp.title}</span>
            </button>
          ))}
        </div>

        <!-- Pista del Carrusel (HTML semántico indexable desde la carga inicial) -->
        <div
          id="experiencias-track"
          data-carousel-track
          tabindex="0"
          role="region"
          aria-roledescription="carrusel"
          aria-label="Catálogo de experiencias turísticas y gastronómicas en La Casona Apapacho"
          class="flex gap-6 sm:gap-8 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-4 px-4 sm:mx-0 sm:px-0 focus-visible:outline-apapacho-mayolico"
        >
          {activeExperiences.map((experience, index) => (
            <article
              id={`experiencia-card-${experience.slug}`}
              data-carousel-slide={index}
               data-experience-slug={experience.slug}
              class="group w-[86vw] sm:w-[400px] md:w-[calc(54%-1rem)] lg:w-[calc(44%-1rem)] shrink-0 snap-start bg-apapacho-arena border border-apapacho-oro/50 rounded-3xl overflow-hidden shadow-warm hover:shadow-warm-lg transition-all duration-300 flex flex-col justify-between"
            >
              <div>
                <!-- Imagen representativa con dimensiones y tratamiento consistentes -->
                <figure class="relative aspect-[16/10] overflow-hidden bg-apapacho-profundo">
                  <picture>
                    <source srcset={experience.image} type="image/webp" />
                    <img
                      src={experience.imageFallback}
                      alt={experience.alt}
                      class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                      width="800"
                      height="500"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                  <div class="absolute inset-0 bg-gradient-to-t from-apapacho-profundo/65 via-transparent to-transparent" />
                </figure>

                <!-- Contenido textual semántico e indexable -->
                <div class="p-6 sm:p-8">
                  <h3 class="font-serif text-2xl sm:text-3xl text-apapacho-profundo leading-snug">
                    {experience.title}
                  </h3>
                  <p class="font-sc text-xs sm:text-sm tracking-wide text-apapacho-mayolico font-semibold mt-1.5">
                    {experience.subtitle}
                  </p>
                  <p class="text-base text-apapacho-profundo/85 leading-relaxed mt-4 text-justify">
                    {experience.description}
                  </p>
                </div>
              </div>

              <!-- Llamado a la acción (CTA) de la experiencia -->
              <div class="px-6 sm:px-8 pb-6 sm:pb-8 pt-2">
                <a
                  href={experience.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn min-h-[48px] h-auto py-3 px-6 w-full rounded-full bg-apapacho-mayolico hover:bg-apapacho-profundo text-apapacho-blanco border border-apapacho-mayolico hover:border-apapacho-profundo font-serif text-base font-normal tracking-wide shadow-warm transition-colors duration-200 flex items-center justify-between"
                >
                  <span>{experience.ctaLabel}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="w-4 h-4 shrink-0 transition-transform duration-200 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  function initExperiencesCarousel() {
    const roots = document.querySelectorAll<HTMLElement>('[data-experiences-carousel]');

    roots.forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-carousel-track]');
      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const indicators = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-indicator]'));
      const currentCounter = root.querySelector<HTMLElement>('[data-carousel-current]');

      if (!track || slides.length === 0) return;

      let activeIndex = 0;

      const updateActiveState = (newIndex: number) => {
        activeIndex = (newIndex + slides.length) % slides.length;

        if (currentCounter) {
          currentCounter.textContent = String(activeIndex + 1);
        }

        indicators.forEach((btn, idx) => {
          const isSelected = idx === activeIndex;
          btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          btn.classList.toggle('bg-apapacho-profundo', isSelected);
          btn.classList.toggle('text-apapacho-arena', isSelected);
          btn.classList.toggle('border-apapacho-profundo', isSelected);
          btn.classList.toggle('shadow-sm', isSelected);
          btn.classList.toggle('font-semibold', isSelected);

          btn.classList.toggle('bg-apapacho-arena/70', !isSelected);
          btn.classList.toggle('text-apapacho-profundo', !isSelected);
          btn.classList.toggle('border-apapacho-oro/50', !isSelected);
          btn.classList.toggle('font-normal', !isSelected);

          const dot = btn.querySelector<HTMLElement>('[data-carousel-dot]');
          if (dot) {
            dot.classList.toggle('bg-apapacho-oro', isSelected);
            dot.classList.toggle('bg-apapacho-adobe/60', !isSelected);
          }
        });
      };

      const scrollToSlide = (index: number) => {
        const targetIndex = (index + slides.length) % slides.length;
        const targetSlide = slides[targetIndex];
        if (!targetSlide) return;

        const trackPaddingLeft = parseFloat(window.getComputedStyle(track).paddingLeft) || 0;
        const targetLeft = targetSlide.offsetLeft - track.offsetLeft - trackPaddingLeft;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollTo({
          left: Math.max(0, targetLeft),
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
        });

        updateActiveState(targetIndex);
      };

      prevBtn?.addEventListener('click', () => {
        scrollToSlide(activeIndex - 1);
      });

      nextBtn?.addEventListener('click', () => {
        scrollToSlide(activeIndex + 1);
      });

      indicators.forEach((btn, index) => {
        btn.addEventListener('click', () => {
          scrollToSlide(index);
        });
      });

      track.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          scrollToSlide(activeIndex + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          scrollToSlide(activeIndex - 1);
        }
      });

      let scrollTicking = false;
      track.addEventListener(
        'scroll',
        () => {
          if (scrollTicking) return;
          scrollTicking = true;
          window.requestAnimationFrame(() => {
            const scrollLeft = track.scrollLeft;
            const maxScrollLeft = track.scrollWidth - track.clientWidth;

            // Si llegó al final del contenedor, marcar la última tarjeta como activa
            if (maxScrollLeft > 0 && scrollLeft >= maxScrollLeft - 12) {
              updateActiveState(slides.length - 1);
              scrollTicking = false;
              return;
            }

            let closestIndex = 0;
            let minDistance = Infinity;
            const trackPaddingLeft = parseFloat(window.getComputedStyle(track).paddingLeft) || 0;

            slides.forEach((slide, idx) => {
              const slideOffset = slide.offsetLeft - track.offsetLeft - trackPaddingLeft;
              const distance = Math.abs(scrollLeft - slideOffset);
              if (distance < minDistance) {
                minDistance = distance;
                closestIndex = idx;
              }
            });

            updateActiveState(closestIndex);
            scrollTicking = false;
          });
        },
        { passive: true }
      );
    });
  }

  initExperiencesCarousel();
  document.addEventListener('astro:page-load', initExperiencesCarousel);
</script>

<style>
  #experiencias-track {
    scrollbar-width: thin;
    scrollbar-color: var(--color-oro) var(--color-arena-suave);
  }
</style>
