---
interface Props {
  facebookUrl: string;
  mapsUrl: string;
  whatsappUrl: string;
}

const { facebookUrl, mapsUrl, whatsappUrl } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-apapacho-profundo text-apapacho-arena border-t border-apapacho-oro/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 pb-10 border-b border-apapacho-oro/25">
      <!-- Marca y Logo -->
      <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
        <picture class="shrink-0">
          <source srcset="/optimized/logo-apapacho.webp" type="image/webp" />
          <img
            src="/LogoApapacho.jpg"
            alt="Logo Apapacho"
            class="w-16 h-16 rounded-full border border-apapacho-oro shadow-md"
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div>
          <p class="font-sc text-2xl text-apapacho-blanco tracking-wide">Apapacho</p>
          <p class="text-sm sm:text-base text-apapacho-arena/85 mt-1">
            Cocina de Autor e Hidrocálida · Dr. Jesús Díaz de León #441, Barrio del Encino
          </p>
        </div>
      </div>

      <!-- Enlaces Sociales y Reservas -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn min-h-[44px] h-11 px-5 rounded-full bg-apapacho-arena/10 hover:bg-apapacho-oro hover:text-apapacho-profundo text-apapacho-arena border border-apapacho-oro/40 font-serif text-base font-normal transition-colors"
        >
          Facebook Oficial
        </a>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn min-h-[44px] h-11 px-5 rounded-full bg-apapacho-arena/10 hover:bg-apapacho-oro hover:text-apapacho-profundo text-apapacho-arena border border-apapacho-oro/40 font-serif text-base font-normal transition-colors"
        >
          Google Maps
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn min-h-[44px] h-11 px-6 rounded-full bg-apapacho-ladrillo hover:bg-apapacho-oro text-apapacho-profundo border-none font-serif text-base font-semibold transition-colors"
        >
          Reservar por WhatsApp
        </a>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-apapacho-arena/80 text-center sm:text-left">
      <p class="tabular-nums">© {currentYear} Restaurante APAPACHO. Todos los derechos reservados.</p>
      <p>Aguascalientes, Ags., México · Hecho con calidez para nuestros comensales.</p>
    </div>
  </div>
</footer>
