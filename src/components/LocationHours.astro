---
interface Props {
  whatsappUrl: string;
  mapsUrl: string;
}

const { whatsappUrl, mapsUrl } = Astro.props;

const schedule = [
  { days: 'Lunes a Sábado', hours: '8:00 a.m. – 11:00 p.m.', badge: 'Desayuno, Comida y Cena' },
  { days: 'Domingo', hours: '8:00 a.m. – 10:00 p.m.', badge: 'Ambiente Familiar' },
];
---

<section id="ubicacion" class="py-20 sm:py-28 bg-apapacho-arena border-t border-apapacho-oro/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-apapacho-profundo">
        Ubicación y Horarios
      </h2>
      <p class="font-sc text-sm tracking-wide text-apapacho-mayolico font-semibold mt-3">
        Visítanos en Aguascalientes · Barrio del Encino
      </p>
      <p class="text-apapacho-profundo/85 mt-3 text-base sm:text-lg">
        Te esperamos en el tradicional Barrio del Encino, a unos pasos del Jardín del Encino.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      <!-- Panel de Dirección y Horarios (sin tarjetas anidadas) -->
      <div class="lg:col-span-6 bg-apapacho-blanco border border-apapacho-oro/50 rounded-3xl shadow-warm p-7 sm:p-10 flex flex-col justify-between">
        <div class="divide-y divide-apapacho-oro/35">
          <!-- Dirección -->
          <div class="flex items-start gap-4 pb-7">
            <div class="w-12 h-12 rounded-2xl bg-apapacho-arena text-apapacho-mayolico border border-apapacho-oro/40 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-2xl text-apapacho-profundo font-semibold">Dirección</h3>
              <p class="text-apapacho-profundo text-lg mt-1 font-medium">
                Dr. Jesús Díaz de León #441, Barrio del Encino
              </p>
              <p class="text-base text-apapacho-profundo/80">
                C.P. 20240, Aguascalientes, Ags., México
              </p>
            </div>
          </div>

          <!-- Horarios de Apertura -->
          <div class="flex items-start gap-4 py-7">
            <div class="w-12 h-12 rounded-2xl bg-apapacho-arena text-apapacho-mayolico border border-apapacho-oro/40 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <div class="w-full">
              <h3 class="font-serif text-2xl text-apapacho-profundo font-semibold mb-4">Horarios de Apertura</h3>
              <dl class="divide-y divide-apapacho-oro/25">
                {
                  schedule.map((item) => (
                    <div class="py-3 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                      <div>
                        <dt class="font-serif font-semibold text-apapacho-profundo text-lg">{item.days}</dt>
                        <dd class="text-sm text-apapacho-profundo/80">{item.badge}</dd>
                      </div>
                      <dd class="font-serif text-lg font-semibold text-apapacho-mayolico tabular-nums">
                        {item.hours}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>

          <!-- Teléfono de Reservaciones -->
          <div class="flex items-start gap-4 pt-7">
            <div class="w-12 h-12 rounded-2xl bg-apapacho-arena text-apapacho-mayolico border border-apapacho-oro/40 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-2xl text-apapacho-profundo font-semibold">Reservaciones Directas</h3>
              <p class="text-base text-apapacho-profundo/80 mt-1">
                Atención personalizada por WhatsApp y llamada telefónica:
              </p>
              <a
                href="tel:+525566294454"
                class="inline-flex items-center min-h-[44px] text-apapacho-mayolico hover:text-apapacho-profundo font-serif font-semibold text-xl underline tabular-nums"
              >
                55 6629 4454
              </a>
            </div>
          </div>
        </div>

        <!-- Botones de Acción: Cómo llegar (Google Maps) y Reservar -->
        <div class="pt-8 mt-8 border-t border-apapacho-oro/35 flex flex-col sm:flex-row gap-3.5">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn min-h-[48px] h-auto py-3 bg-apapacho-mayolico hover:bg-apapacho-profundo text-apapacho-blanco border-none rounded-full flex-1 text-lg font-serif font-normal shadow-warm transition-colors duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
            </svg>
            Cómo llegar
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn min-h-[48px] h-auto py-3 bg-transparent border border-apapacho-profundo text-apapacho-profundo hover:bg-apapacho-profundo hover:text-apapacho-arena rounded-full flex-1 text-lg font-serif font-normal transition-colors duration-300"
          >
            Reservar mesa
          </a>
        </div>
      </div>

      <!-- Mapa Interactivo de Google Maps -->
      <div class="lg:col-span-6 bg-apapacho-blanco border border-apapacho-oro/50 rounded-3xl shadow-warm overflow-hidden min-h-[380px] sm:min-h-[450px] flex flex-col justify-between">
        <iframe
          title="Mapa de ubicación de Restaurante APAPACHO en el Barrio del Encino, Aguascalientes"
          src="https://www.google.com/maps?q=21.8755675,-102.2927562&hl=es&z=17&output=embed"
          class="w-full flex-1 min-h-[380px] sm:min-h-[460px] border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div class="p-4 sm:px-6 bg-apapacho-blanco border-t border-apapacho-oro/35 flex items-center justify-between gap-4">
          <div class="text-sm sm:text-base">
            <span class="font-serif font-semibold text-apapacho-profundo">APAPACHO · Barrio del Encino</span>
            <span class="block text-apapacho-profundo/80 text-xs sm:text-sm tabular-nums">Coordenadas: 21.8755° N, 102.2927° O</span>
          </div>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 min-h-[44px] text-sm sm:text-base font-serif font-semibold text-apapacho-mayolico hover:text-apapacho-profundo underline shrink-0"
          >
            <span>Abrir en Google Maps</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
