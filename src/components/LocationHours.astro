---
interface Props {
  whatsappUrl: string;
  mapsUrl: string;
}

const { whatsappUrl, mapsUrl } = Astro.props;

const schedule = [
  { days: 'Lunes a Sábado', hours: '8:00 a.m. – 11:00 p.m.', badge: 'Desayuno, Comida y Cena' },
  { days: 'Domingo', hours: '8:00 a.m. – 10:00 p.m.', badge: 'Ambiente Familiar' },
];
---

<section id="ubicacion" class="py-20 sm:py-28 bg-apapacho-bg-alt/60 border-t border-apapacho-primary/20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-apapacho-primary text-xs uppercase tracking-[0.25em] font-semibold">
        Visítanos en Aguascalientes
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-apapacho-text mt-2">
        Ubicación y Horarios
      </h2>
      <p class="text-apapacho-text-muted mt-3 text-sm sm:text-base">
        Te esperamos en el tradicional Barrio del Encino, a unos pasos del Jardín del Encino.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      <!-- Tarjeta de Dirección y Horarios -->
      <div class="lg:col-span-6 card bg-apapacho-bg border border-apapacho-primary/30 rounded-3xl shadow-warm p-7 sm:p-10 flex flex-col justify-between">
        <div class="space-y-8">
          <!-- Dirección -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-apapacho-primary/15 text-apapacho-primary flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl text-apapacho-text font-semibold">Dirección</h3>
              <p class="text-apapacho-text mt-1 font-medium">
                Dr. Jesús Díaz de León #441, Barrio del Encino
              </p>
              <p class="text-sm text-apapacho-text-muted">
                C.P. 20240, Aguascalientes, Ags., México
              </p>
            </div>
          </div>

          <!-- Horarios de Apertura -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-apapacho-primary/15 text-apapacho-primary flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <div class="w-full">
              <h3 class="font-serif text-xl text-apapacho-text font-semibold mb-3">Horarios de Apertura</h3>
              <div class="space-y-3">
                {
                  schedule.map((item) => (
                    <div class="p-3.5 rounded-2xl bg-apapacho-surface border border-apapacho-primary/15 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                      <div>
                        <p class="font-semibold text-apapacho-text text-sm">{item.days}</p>
                        <p class="text-xs text-apapacho-text-muted">{item.badge}</p>
                      </div>
                      <span class="font-serif text-base font-semibold text-apapacho-primary-dark">
                        {item.hours}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Teléfono de Reservaciones -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-apapacho-primary/15 text-apapacho-primary flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl text-apapacho-text font-semibold">Reservaciones Directas</h3>
              <p class="text-sm text-apapacho-text-muted mt-1">
                Atención personalizada por WhatsApp y llamada telefónica:
              </p>
              <a href="tel:+525566294454" class="text-apapacho-primary-dark font-semibold text-base hover:underline">
                55 6629 4454
              </a>
            </div>
          </div>
        </div>

        <!-- Botones de Acción: Cómo llegar (Google Maps) y Reservar -->
        <div class="pt-8 mt-8 border-t border-apapacho-primary/20 flex flex-col sm:flex-row gap-3">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-apapacho-primary hover:bg-apapacho-primary-dark text-white border-none rounded-full flex-1 text-base font-medium shadow-warm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
            </svg>
            Cómo llegar
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline border-apapacho-primary text-apapacho-primary-dark hover:bg-apapacho-primary hover:text-white hover:border-apapacho-primary rounded-full flex-1 text-base font-medium"
          >
            Reservar mesa
          </a>
        </div>
      </div>

      <!-- Mapa Interactivo de Google Maps -->
      <div class="lg:col-span-6 card bg-apapacho-bg border border-apapacho-primary/30 rounded-3xl shadow-warm overflow-hidden min-h-[380px] sm:min-h-[450px] relative">
        <iframe
          title="Mapa de ubicación de Restaurante APAPACHO en el Barrio del Encino, Aguascalientes"
          src="https://www.google.com/maps?q=21.8755675,-102.2927562&hl=es&z=17&output=embed"
          class="w-full h-full min-h-[380px] sm:min-h-[480px] border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div class="p-4 bg-apapacho-bg/95 backdrop-blur-sm border-t border-apapacho-primary/20 flex items-center justify-between gap-4">
          <div class="text-xs sm:text-sm">
            <span class="font-semibold text-apapacho-text">APAPACHO · Barrio del Encino</span>
            <span class="block text-apapacho-text-muted text-xs">Coordenadas: 21.8755° N, 102.2927° O</span>
          </div>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover text-xs sm:text-sm font-semibold text-apapacho-primary-dark shrink-0"
          >
            Abrir en Google Maps →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
