---
interface Props {
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-apapacho-arena/95 backdrop-blur-md border-b border-apapacho-oro/40 transition-colors duration-300">
  <div class="navbar max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[4.75rem]">
    <!-- Brand / Logo -->
    <div class="navbar-start">
      <a
        href="#inicio"
        class="flex items-center gap-3.5 group rounded-xl py-1 pr-2 focus-visible:outline-apapacho-mayolico"
        aria-label="Ir al inicio de Apapacho"
      >
        <div class="w-12 h-12 rounded-full overflow-hidden border border-apapacho-adobe/50 shadow-sm transition-transform duration-300 group-hover:scale-105 shrink-0 bg-apapacho-adobe">
          <picture>
            <source srcset="/optimized/logo-apapacho.webp" type="image/webp" />
            <img
              src="/LogoApapacho.jpg"
              alt="Emblema oficial de Restaurante Apapacho en Aguascalientes"
              class="w-full h-full object-cover"
              width="48"
              height="48"
              decoding="async"
            />
          </picture>
        </div>
        <div class="flex flex-col">
          <span class="font-sc text-xl sm:text-2xl tracking-wide text-apapacho-profundo leading-none">
            Apapacho
          </span>
          <span class="font-sc text-xs uppercase tracking-[0.12em] text-apapacho-mayolico font-semibold mt-1">
            Barrio del Encino
          </span>
        </div>
      </a>
    </div>

    <!-- Navegación Desktop -->
    <nav class="navbar-center hidden md:flex" aria-label="Navegación principal">
      <ul class="menu menu-horizontal px-1 gap-1.5 text-base font-serif text-apapacho-profundo">
        <li>
          <a
            href="#experiencia"
            class="min-h-[44px] px-4 rounded-full hover:bg-apapacho-oro/25 hover:text-apapacho-profundo transition-colors"
          >
            La Experiencia
          </a>
        </li>
        <li>
          <a
            href="#especialidades"
            class="min-h-[44px] px-4 rounded-full hover:bg-apapacho-oro/25 hover:text-apapacho-profundo transition-colors"
          >
            Platillos y Desayunos
          </a>
        </li>
        <li>
          <a
            href="#resenas"
            class="min-h-[44px] px-4 rounded-full hover:bg-apapacho-oro/25 hover:text-apapacho-profundo transition-colors"
          >
            Reseñas
          </a>
        </li>
        <li>
          <a
            href="#ubicacion"
            class="min-h-[44px] px-4 rounded-full hover:bg-apapacho-oro/25 hover:text-apapacho-profundo transition-colors"
          >
            Ubicación y Horarios
          </a>
        </li>
      </ul>
    </nav>

    <!-- Botón de Reserva + Menú Móvil -->
    <div class="navbar-end gap-2.5">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn min-h-[44px] h-11 bg-apapacho-mayolico hover:bg-apapacho-profundo text-apapacho-blanco border border-apapacho-mayolico hover:border-apapacho-profundo rounded-full px-5 sm:px-6 text-base font-serif font-normal tracking-wide shadow-warm transition-all duration-300 hover:-translate-y-0.5"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-4 h-4 shrink-0"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Reservar</span>
      </a>

      <!-- Dropdown Mobile -->
      <div class="dropdown dropdown-end md:hidden">
        <div
          tabindex="0"
          role="button"
          class="btn btn-ghost btn-circle min-h-[44px] min-w-[44px] text-apapacho-profundo hover:bg-apapacho-oro/25"
          aria-label="Abrir menú de navegación"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h10" />
          </svg>
        </div>
        <ul
          tabindex="0"
          class="menu dropdown-content mt-3 z-50 p-3 shadow-warm-lg bg-apapacho-blanco rounded-2xl w-64 border border-apapacho-oro/40 space-y-1 text-base font-serif text-apapacho-profundo"
        >
          <li><a href="#experiencia" class="min-h-[44px] py-2.5 rounded-xl hover:bg-apapacho-arena">La Experiencia</a></li>
          <li><a href="#especialidades" class="min-h-[44px] py-2.5 rounded-xl hover:bg-apapacho-arena">Platillos y Desayunos</a></li>
          <li><a href="#resenas" class="min-h-[44px] py-2.5 rounded-xl hover:bg-apapacho-arena">Reseñas</a></li>
          <li><a href="#ubicacion" class="min-h-[44px] py-2.5 rounded-xl hover:bg-apapacho-arena">Ubicación y Horarios</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>
