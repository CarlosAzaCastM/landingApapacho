---
interface Props {
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-apapacho-bg/90 backdrop-blur-md border-b border-apapacho-primary/20 transition-all duration-300">
  <div class="navbar max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[4.5rem]">
    <!-- Brand / Logo -->
    <div class="navbar-start">
      <a href="#inicio" class="flex items-center gap-3 group focus:outline-none" aria-label="Ir al inicio de Apapacho">
        <div class="w-11 h-11 rounded-full overflow-hidden border border-apapacho-primary/40 shadow-sm transition-transform duration-300 group-hover:scale-105">
          <img
            src="/LogoApapacho.jpg"
            alt="Logo Restaurante Apapacho Aguascalientes"
            class="w-full h-full object-cover"
            width="44"
            height="44"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-lg sm:text-xl tracking-[0.18em] font-semibold text-apapacho-dark">
            APAPACHO
          </span>
          <span class="text-[10px] uppercase tracking-[0.22em] text-apapacho-primary font-medium -mt-1">
            Barrio del Encino
          </span>
        </div>
      </a>
    </div>

    <!-- Navegación Desktop -->
    <div class="navbar-center hidden md:flex">
      <ul class="menu menu-horizontal px-1 gap-2 text-sm font-medium text-apapacho-text">
        <li>
          <a href="#experiencia" class="rounded-full hover:bg-apapacho-primary/10 hover:text-apapacho-primary transition-colors">
            La Experiencia
          </a>
        </li>
        <li>
          <a href="#especialidades" class="rounded-full hover:bg-apapacho-primary/10 hover:text-apapacho-primary transition-colors">
            Platillos Insignia
          </a>
        </li>
        <li>
          <a href="#resenas" class="rounded-full hover:bg-apapacho-primary/10 hover:text-apapacho-primary transition-colors">
            Reseñas
          </a>
        </li>
        <li>
          <a href="#ubicacion" class="rounded-full hover:bg-apapacho-primary/10 hover:text-apapacho-primary transition-colors">
            Ubicación y Horarios
          </a>
        </li>
      </ul>
    </div>

    <!-- Botón de Reserva + Menú Móvil -->
    <div class="navbar-end gap-2">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm sm:btn-md bg-apapacho-primary hover:bg-apapacho-primary-dark text-white border-none rounded-full px-4 sm:px-6 font-medium tracking-wide shadow-warm transition-all duration-300 hover:-translate-y-0.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path
            fill-rule="evenodd"
            d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z"
            clip-rule="evenodd"
          />
        </svg>
        <span class="hidden xs:inline">Reservar</span>
      </a>

      <!-- Dropdown Mobile -->
      <div class="dropdown dropdown-end md:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle text-apapacho-text" aria-label="Abrir menú de navegación">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
        </div>
        <ul
          tabindex="0"
          class="menu menu-sm dropdown-content mt-3 z-[1] p-3 shadow-warm-lg bg-apapacho-bg rounded-2xl w-56 border border-apapacho-primary/20 space-y-1"
        >
          <li><a href="#experiencia" class="py-2.5 rounded-xl">La Experiencia</a></li>
          <li><a href="#especialidades" class="py-2.5 rounded-xl">Platillos Insignia</a></li>
          <li><a href="#resenas" class="py-2.5 rounded-xl">Reseñas</a></li>
          <li><a href="#ubicacion" class="py-2.5 rounded-xl">Ubicación y Horarios</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>
