---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Menú Legado Hidrocálido | APAPACHO',
  description = 'Descubre el Legado Hidrocálido de APAPACHO. Sabor que acaricia el alma con recetas que honran el fuego familiar y la memoria colectiva de Aguascalientes.',
} = Astro.props;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'APAPACHO',
  image: '/LogoApapacho.jpg',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Dr. Jesús Díaz de León #441, Barrio del Encino',
    addressLocality: 'Aguascalientes',
    addressRegion: 'Ags.',
    postalCode: '20240',
    addressCountry: 'MX',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 21.8755675,
    longitude: -102.2927562,
  },
  url: 'https://maps.app.goo.gl/FgUjnRGGR16cpcux5',
  telephone: '+525566294454',
  servesCuisine: ['Mexicana', 'Hidrocálida de Autor', 'Contemporánea'],
  priceRange: '$$',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '23:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '08:00',
      closes: '22:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '180',
  },
};
---

<!doctype html>
<!-- impeccable-disable cream-palette -- Color primario oficial de marca Arena suave (#FEF2E7) -->
<html lang="es" data-theme="apapacho" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#A6824C" />
    <link rel="icon" type="image/jpeg" href="/LogoApapacho.jpg" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/LogoApapacho.jpg" />
    <meta property="og:locale" content="es_MX" />

    <!-- Precarga de tipografía oficial local EB Garamond y fotografía principal (LCP) -->
    <link rel="preload" href="/eb-garamond/EBGaramond12-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/eb-garamond/EBGaramond12-Italic.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/eb-garamond/EBGaramondSC12-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/eb-garamond/EBGaramond08-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/optimized/bendita-comunion.webp" as="image" type="image/webp" fetchpriority="high" />

    <!-- Datos Estructurados SEO Local -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="bg-[var(--color-arena-suave)] text-[var(--color-gris-profundo)] font-sans antialiased selection:bg-[var(--color-verde-mayolico)] selection:text-[var(--color-blanco-puro)]">
    
    <main class="max-w-6xl mx-auto px-4 py-12 md:py-24">
      <!-- Cabecera del Menú -->
      <header class="text-center mb-20 space-y-6">
        <h1 class="text-5xl md:text-7xl font-bold text-[var(--color-adobe)] tracking-wide uppercase">
          Legado Hidrocálido
        </h1>
        <p class="text-2xl md:text-4xl italic text-[var(--color-ladrillo)] font-serif">
          "Sabor que acaricia el Alma"
        </p>
        
        <div class="max-w-3xl mx-auto mt-12 p-8 md:p-12 border-2 border-[var(--color-oro)] rounded-2xl bg-[var(--color-blanco-puro)]/60 backdrop-blur-sm shadow-sm relative">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[var(--color-arena-suave)] px-4 text-[var(--color-oro)]">
            ✦
          </div>
          <p class="text-xl md:text-2xl leading-relaxed text-[var(--color-gris-profundo)] font-serif italic text-center">
            Cada receta que aquí encuentras tiene alma, tierra y un legado transmitido con manos sabias. Cada platillo honra el fuego familiar, la memoria colectiva y la dignidad de nuestras cocinas. Gracias por apapacharte con nosotros y permitir que el amor a nuestra tierra se sirva en tu mesa. ¡Porque la Gente Buena merece un Apapacho!
          </p>
        </div>
      </header>

      <!-- Cuadrícula Interactiva de Platillos -->
      <section class="mb-28">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
          
          <!-- Platillo 1 -->
          <article class="group relative bg-[var(--color-blanco-puro)] rounded-3xl p-8 shadow-sm hover:shadow-2xl transition-all duration-500 border border-[var(--color-oro)]/30 hover:border-[var(--color-verde-mayolico)] flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2 gap-4">
                <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-ladrillo)] group-hover:text-[var(--color-adobe)] transition-colors leading-tight">Chile a la Antigua Aguascalientes</h2>
                <span class="text-2xl font-bold text-[var(--color-verde-mayolico)] bg-[var(--color-arena-suave)] px-4 py-2 rounded-xl shrink-0">$363</span>
              </div>
              <a href="#autora-martha" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-[var(--color-oro)] hover:text-[var(--color-adobe)] mb-6 transition-colors group/link">
                Autora: Martha Esparza 
                <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
              </a>
              <p class="text-lg md:text-xl text-[var(--color-gris-profundo)] leading-relaxed">
                <strong class="text-[var(--color-adobe)]">Apapáchate con este exquisito:</strong> Chile ancho local escalfado en hierbas y piloncillo, relleno de carne molida, frutos secos, frescos y semillas, bañado en crema de guayaba, que representa los ingredientes del Antiguo Aguascalientes.
              </p>
            </div>
          </article>

          <!-- Platillo 2 -->
          <article class="group relative bg-[var(--color-blanco-puro)] rounded-3xl p-8 shadow-sm hover:shadow-2xl transition-all duration-500 border border-[var(--color-oro)]/30 hover:border-[var(--color-verde-mayolico)] flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2 gap-4">
                <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-ladrillo)] group-hover:text-[var(--color-adobe)] transition-colors leading-tight">Tacos de Cabeza de Toro</h2>
                <span class="text-2xl font-bold text-[var(--color-verde-mayolico)] bg-[var(--color-arena-suave)] px-4 py-2 rounded-xl shrink-0">$219</span>
              </div>
              <a href="#autora-liz" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-[var(--color-oro)] hover:text-[var(--color-adobe)] mb-6 transition-colors group/link">
                Autora: Liz Macías 
                <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
              </a>
              <p class="text-lg md:text-xl text-[var(--color-gris-profundo)] leading-relaxed">
                <strong class="text-[var(--color-adobe)]">Apapáchate con este exquisito:</strong> Platillo original del auge de las Haciendas y la crianza de ganado bravo, esta receta reúne los mejores ingredientes hidrocálidos para el sazón del adobo que es usado en la cocción tersa de la cabeza de toro. Servida en tacos con una salsa especial, es ideal como entrada ó con bebidas espirituosas.
              </p>
            </div>
          </article>

          <!-- Platillo 3 -->
          <article class="group relative bg-[var(--color-blanco-puro)] rounded-3xl p-8 shadow-sm hover:shadow-2xl transition-all duration-500 border border-[var(--color-oro)]/30 hover:border-[var(--color-verde-mayolico)] flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2 gap-4">
                <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-ladrillo)] group-hover:text-[var(--color-adobe)] transition-colors leading-tight">Tamales Romance</h2>
                <span class="text-2xl font-bold text-[var(--color-verde-mayolico)] bg-[var(--color-arena-suave)] px-4 py-2 rounded-xl shrink-0">$119</span>
              </div>
              <a href="#autora-mayte" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-[var(--color-oro)] hover:text-[var(--color-adobe)] mb-6 transition-colors group/link">
                Autora: Mayté Esparza 
                <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
              </a>
              <p class="text-lg md:text-xl text-[var(--color-gris-profundo)] leading-relaxed">
                <strong class="text-[var(--color-adobe)]">Apapáchate con este exquisito:</strong> Platillo que muestra la experiencia de la cocina hidrocálida en la elaboración de tamales basados en técnicas tradicionales, con sabores y toques espectaculares que dan al plato la sensación de una larga historia de sabores exquisitos. Se sirve un tamal con una salsa especial y toques florales.
              </p>
            </div>
          </article>

          <!-- Platillo 4 -->
          <article class="group relative bg-[var(--color-blanco-puro)] rounded-3xl p-8 shadow-sm hover:shadow-2xl transition-all duration-500 border border-[var(--color-oro)]/30 hover:border-[var(--color-verde-mayolico)] flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2 gap-4">
                <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-ladrillo)] group-hover:text-[var(--color-adobe)] transition-colors leading-tight">Plato Trianero</h2>
                <span class="text-2xl font-bold text-[var(--color-verde-mayolico)] bg-[var(--color-arena-suave)] px-4 py-2 rounded-xl shrink-0">$249</span>
              </div>
              <a href="#autora-irma" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-[var(--color-oro)] hover:text-[var(--color-adobe)] mb-6 transition-colors group/link">
                Autora: Irma Medina
                <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
              </a>
              <p class="text-lg md:text-xl text-[var(--color-gris-profundo)] leading-relaxed">
                <strong class="text-[var(--color-adobe)]">Apapáchate con esta exquisita:</strong> Carne de cerdo cocida en una salsa suave de frutas, jitomate y rajas de chile poblano, plato representativo del Barrio del Encino ó Barrio de Triana, por sus huertos y solares en casas, pórticos y patios. Es ideal para paladares delicados con gusto por la comida de tonos dulces.
              </p>
            </div>
          </article>

          <!-- Platillo 5 (Destacado Full Width) -->
          <article class="group relative bg-[var(--color-blanco-puro)] rounded-3xl p-8 shadow-sm hover:shadow-2xl transition-all duration-500 border border-[var(--color-oro)]/30 hover:border-[var(--color-verde-mayolico)] lg:col-span-2 flex flex-col justify-between">
            <div class="lg:flex gap-8 items-center">
              <div class="flex-1">
                <div class="flex justify-between items-start mb-2 gap-4">
                  <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-ladrillo)] group-hover:text-[var(--color-adobe)] transition-colors leading-tight">Mole de Verdolagas y Condoches</h2>
                  <span class="text-2xl font-bold text-[var(--color-verde-mayolico)] bg-[var(--color-arena-suave)] px-4 py-2 rounded-xl shrink-0">$286</span>
                </div>
                <div class="flex flex-wrap gap-4 mb-6">
                  <a href="#autora-noemi" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-[var(--color-oro)] hover:text-[var(--color-adobe)] transition-colors group/link">
                    Autora: Noemí Quiroz <span class="ml-1 transform group-hover/link:translate-x-1 transition-transform">→</span>
                  </a>
                  <span class="text-[var(--color-verde-mayolico)]">|</span>
                  <a href="#autora-paula" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-[var(--color-oro)] hover:text-[var(--color-adobe)] transition-colors group/link">
                    Paula y Cltv. Malacate <span class="ml-1 transform group-hover/link:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
                <p class="text-lg md:text-xl text-[var(--color-gris-profundo)] leading-relaxed">
                  <strong class="text-[var(--color-adobe)]">Apapáchate con este exquisito:</strong> Platillo originario del municipio de San José de Gracia, inspirado en los ingredientes en torno a la milpa, con un equilibrio y textura inigualables; está compuesto por chile poblano, hierbas verdes, verdolagas, semillas tostadas y tres horas de integración a fuego lento, servido con condoches de sal al horno de leña.
                </p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- Sección de Autoras (Targets para los anclajes) -->
      <section class="bg-[var(--color-verde-mayolico)]/5 rounded-[2.5rem] p-8 md:p-16 border-2 border-[var(--color-verde-mayolico)]/10">
        <h2 class="text-4xl md:text-5xl font-bold text-center text-[var(--color-verde-mayolico)] mb-16 uppercase tracking-wide">
          Conoce a las autoras
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          
          <div id="autora-martha" class="scroll-mt-32 bg-[var(--color-blanco-puro)] p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border-t-4 border-t-[var(--color-adobe)]">
            <h3 class="text-2xl font-bold text-[var(--color-adobe)] mb-1">Martha Esparza</h3>
            <p class="text-md italic text-[var(--color-ladrillo)] mb-4 font-serif">Chile a la Antigua Aguascalientes</p>
            <p class="text-lg text-[var(--color-gris-profundo)] leading-relaxed">
              Originaria del Barrio del Encino, Martha es guardiana de un sabor que no se aprende en escuelas, sino en la cocina de la abuela. Sus manos son enciclopedia viva de chiles, conservas, frutas cocidas y secretos heredados. Lo suyo no es sólo cocinar, es preservar el alma del barrio más emblemático de esta tierra.
            </p>
          </div>

          <div id="autora-liz" class="scroll-mt-32 bg-[var(--color-blanco-puro)] p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border-t-4 border-t-[var(--color-adobe)]">
            <h3 class="text-2xl font-bold text-[var(--color-adobe)] mb-1">Liz Macías</h3>
            <p class="text-md italic text-[var(--color-ladrillo)] mb-4 font-serif">Tacos de cabeza de toro en adobo</p>
            <p class="text-lg text-[var(--color-gris-profundo)] leading-relaxed">
              Hija del legendario "Súper Gallo", Liz lleva más de 15 años cocinando con el corazón en las manos. Creció entre mesas, aromas y las enseñanzas de su padre, quien vendía pozole, enchiladas y tacos en el corazón de Aguascalientes. Su sazón no solo es tradición: es identidad hidrocálida.
            </p>
          </div>

          <div id="autora-mayte" class="scroll-mt-32 bg-[var(--color-blanco-puro)] p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border-t-4 border-t-[var(--color-adobe)]">
            <h3 class="text-2xl font-bold text-[var(--color-adobe)] mb-1">Mayté Esparza Diaz</h3>
            <p class="text-md italic text-[var(--color-ladrillo)] mb-4 font-serif">Tamales Romance</p>
            <p class="text-lg text-[var(--color-gris-profundo)] leading-relaxed">
              Chef, socióloga y maestra en arte e innovación, Mayté ha dedicado su vida a rescatar y celebrar la cocina tradicional de Aguascalientes. Sus Tamales Romance fusionan técnicas ancestrales con un toque poético y floral.
            </p>
          </div>

          <div id="autora-irma" class="scroll-mt-32 bg-[var(--color-blanco-puro)] p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border-t-4 border-t-[var(--color-adobe)]">
            <h3 class="text-2xl font-bold text-[var(--color-adobe)] mb-1">Irma Leticia Medina Ramirez</h3>
            <p class="text-md italic text-[var(--color-ladrillo)] mb-4 font-serif">Plato Trianero</p>
            <p class="text-lg text-[var(--color-gris-profundo)] leading-relaxed">
              Desde el histórico barrio de Triana, Irma Leticia cocina con el alma de sus ancestras latiendo en sus manos. Hoy, Irma honra ese legado con orgullo, llevando la voz de sus raíces a concursos nacionales y mesas donde aún se aprecia la cocina que cuenta historias.
            </p>
          </div>

          <div id="autora-noemi" class="scroll-mt-32 bg-[var(--color-blanco-puro)] p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border-t-4 border-t-[var(--color-adobe)]">
            <h3 class="text-2xl font-bold text-[var(--color-adobe)] mb-1">Noemí Quiroz</h3>
            <p class="text-md italic text-[var(--color-ladrillo)] mb-4 font-serif">Mole de verdolagas acompañado de condoches</p>
            <p class="text-lg text-[var(--color-gris-profundo)] leading-relaxed">
              Desde San José de Gracia, Noemí representa la cuarta generación de mujeres que cocinan con memoria. Aprendió mirando a su madre, cocinando con el corazón abierto, y ganando premios con platillos que cuentan historias de amor. Su mole verde de verdolagas es un tributo vivo al recuerdo, la familia y la tierra.
            </p>
          </div>

          <div id="autora-paula" class="scroll-mt-32 bg-[var(--color-blanco-puro)] p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border-t-4 border-t-[var(--color-adobe)]">
            <h3 class="text-2xl font-bold text-[var(--color-adobe)] mb-1">Paula Reyes y Colectivo Malacate</h3>
            <p class="text-md italic text-[var(--color-ladrillo)] mb-4 font-serif">Mole de verdolagas acompañado de condoches</p>
            <p class="text-lg text-[var(--color-gris-profundo)] leading-relaxed">
              Cinco mujeres, tres generaciones y un mismo fuego: la leña que enciende la cocina del Malacate. Paula y el Colectivo Malacate, cocinan como se hacía antes: con tiempo, con maíz nixtamalizado, con sazón de raíz. Cada condoche es una celebración de la comunidad, una ofrenda al pasado y un abrazo cálido que viaja desde su comal hasta tu mesa.
            </p>
          </div>

        </div>
      </section>

      <!-- Pie de página Institucional -->
      <footer class="mt-24 text-center max-w-4xl mx-auto px-4">
        <p class="text-lg font-bold text-[var(--color-oro)] uppercase tracking-widest mb-6">APAPACHO | LEGADO HIDROCÁLIDO</p>
        <p class="text-base text-[var(--color-gris-profundo)]/80 leading-relaxed">
          Nace de la colaboración entre Restaurante Apapacho, Aguascalientes Sí Saaabe, el Instituto Cultural de Aguascalientes y Mujeres Cocineras Tradicionales de la Región. Coordinado por Mayté Esparza, chef, socióloga, maestra en arte e innovación, y guardiana del Patrimonio Gastronómico Hidrocálido.
        </p>
      </footer>
    </main>

  </body>
</html>

<style is:global>
  /* Tipografía Oficial de Marca: EB Garamond (12pt, 08pt y Small Caps) */
  @font-face {
    font-family: 'EB Garamond';
    src: url('/eb-garamond/EBGaramond12-Regular.ttf') format('truetype');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'EB Garamond';
    src: url('/eb-garamond/EBGaramond12-Italic.ttf') format('truetype');
    font-weight: 400 700;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'EB Garamond 08';
    src: url('/eb-garamond/EBGaramond08-Regular.ttf') format('truetype');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'EB Garamond 08';
    src: url('/eb-garamond/EBGaramond08-Italic.ttf') format('truetype');
    font-weight: 400 700;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'EB Garamond SC';
    src: url('/eb-garamond/EBGaramondSC12-Regular.ttf') format('truetype');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'EB Garamond SC 08';
    src: url('/eb-garamond/EBGaramondSC08-Regular.ttf') format('truetype');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'EB Garamond AllSC';
    src: url('/eb-garamond/EBGaramond12-AllSC.ttf') format('truetype');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Paleta Primaria Oficial */
    --color-arena-suave: #FEF2E7;
    --color-adobe: #A6824C;
    --color-ladrillo: #D7846A;

    /* Paleta Secundaria Oficial */
    --color-oro: #C29E67;
    --color-verde-mayolico: #487274;
    --color-gris-profundo: #212121;
    --color-blanco-puro: #FFFFFF;

    /* Canales RGB para opacidad en utilidades Tailwind */
    --rgb-arena-suave: 254 242 231;
    --rgb-adobe: 166 130 76;
    --rgb-ladrillo: 215 132 106;
    --rgb-oro: 194 158 103;
    --rgb-verde-mayolico: 72 114 116;
    --rgb-gris-profundo: 33 33 33;
    --rgb-blanco-puro: 255 255 255;

    color-scheme: light;
    caret-color: var(--color-verde-mayolico);
    scrollbar-color: var(--color-adobe) var(--color-arena-suave);
    scrollbar-width: thin;
  }

  html {
    font-family: 'EB Garamond 08', 'EB Garamond', Georgia, serif;
    background-color: var(--color-arena-suave);
    color: var(--color-gris-profundo);
    text-underline-offset: 0.22em;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: 'EB Garamond', Georgia, serif;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  /* Superficies del navegador personalizadas con la paleta oficial */
  ::selection {
    background-color: var(--color-verde-mayolico);
    color: var(--color-blanco-puro);
  }

  :focus-visible {
    outline: 2px solid var(--color-verde-mayolico);
    outline-offset: 3px;
  }

  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-arena-suave);
  }

  ::-webkit-scrollbar-thumb {
    background-color: var(--color-oro);
    border-radius: 9999px;
    border: 2px solid var(--color-arena-suave);
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-adobe);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
